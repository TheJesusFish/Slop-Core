    <nvram index="2" size="784" />
    <switches page_id="1" page_name="DIP Switches" base="8" default="00,00,00">
        <!-- DSW A -->
        <dip name="Test Mode" bits="0" ids="Off,On" />
        <dip name="Credits to Start" bits="1" ids="1,2" />
        <dip name="Coin A" bits="2,4" ids="1/1,1/2,1/3,1/4,2/1,3/1,4/1,Free Play" />
        <dip name="Coin B" bits="5,7" ids="1/1,1/2,1/3,1/4,2/1,3/1,4/1" />
        <dip name="Joystick Mode (Free Play)" bits="1" ids="Normal,90 degrees ACW" />
        <dip name="Hit Score (Free Play)" bits="5" ids="Off,On" />
        <dip name="Sound Effect (Free Play)" bits="6" ids="Off,On" />
        <dip name="Music (Free Play)" bits="7" ids="Off,On" />
        <!-- DSW B -->
        <dip name="Start Rank" bits="8,9" ids="Normal,Easy,Hard,Very Hard" />
        <dip name="Timer Rank" bits="10,11" ids="Normal,Low,High,Highest" />
        <dip name="Player Counts" bits="12,13" ids="3,4,2,1" />
        <dip name="Extra Player" bits="14,15" ids="Every 1500k,Every 1000k,Every 2000k,None" />
        <!-- SYS-DSW -->
        <dip name="Screen Flip" bits="16" ids="Off,On" />
        <dip name="Demo Sound" bits="17" ids="On,Off" />
        <dip name="Stage Edit" bits="18" ids="Off,On" />
        <dip name="Continue Play" bits="19" ids="Yes,No" />
        <dip name="Invincible" bits="20" ids="Off,On" />
        <dip name="Guest Players" bits="21" ids="On,Off" />
        <dip name="Player Select" bits="22" ids="On,Off" />
        <dip name="Special Course" bits="23" ids="On,Off" />
    </switches>
    <buttons names="Shot,Bomb,Formation,Start,Coin,Pause,-,-,-,Save/Load" default="A,B,X,Start,Select,R,L" count="3" />
</misterromdescription>
