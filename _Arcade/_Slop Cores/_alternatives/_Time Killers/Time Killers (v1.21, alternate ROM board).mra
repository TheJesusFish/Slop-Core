<?xml version="1.0"?>
<misterromdescription>
    <name>Time Killers (v1.21, alternate ROM board)</name>
    <setname>timekill121a</setname>
    <rbf>ITech32</rbf>
    <mameversion>0288</mameversion>
    <year>1992</year>
    <manufacturer>Strata / Incredible Technologies</manufacturer>
    <players>2</players>
    <joystick>8-way</joystick>
    <rotation>Horizontal</rotation>
    <region>World</region>
    <platform>Incredible Technologies 16-bit</platform>
    <category>Fighting</category>

    <!-- These are the physical SW1 bits in the 68000 DIPS byte. -->
    <switches default="00">
        <dip name="Flip Screen" bits="5" ids="Off,On"/>
        <dip name="Violence" bits="6" ids="On,Off"/>
        <dip name="Service Mode" bits="7" ids="Off,On"/>
    </switches>

    <!--
        MAME numbers the cabinet limb switches Button 1 through Button 5.
        Keep the unused B6 slot explicit so Start/Coin remain in the fixed
        CONF_STR J positions (joystick bits 10/11); Main_MiSTer skips a "-"
        name without consuming an entry from the seven-item default list.
    -->
    <buttons names="Button 1,Button 2,Button 3,Button 4,Button 5,-,Start,Coin" default="Y,X,L,B,A,Start,Select" count="5"/>

    <!-- Board selector must precede the bulk DDR stream. -->
    <rom index="1">
        <part>01</part>
    </rom>

    <!-- 16 KiB battery-backed work RAM at CPU 0x000000-0x003fff. -->
    <nvram index="2" size="16384"/>

    <rom index="0" zip="timekill121a.zip|timekill.zip" md5="5d77dfdd39983d47a678974e856f856a" address="0x30000000">
        <!-- 0x0000000: 68000 big-endian program ROM, 512 KiB. -->
        <interleave output="16">
            <part name="tk00_v1.21_u54.u54" crc="4938a940" map="01"/>
            <part name="tk01_v1.21_u53.u53" crc="0bb75c40" map="10"/>
        </interleave>
        <part repeat="0x380000">00</part>

        <!-- 0x0400000: MAME soundcpu region, including ROM_CONTINUE. -->
        <part repeat="0x08000">00</part>
        <part name="timekillsnd_u17.u17" crc="ab1684c3" offset="0x18000" length="0x08000"/>
        <part name="timekillsnd_u17.u17" crc="ab1684c3" offset="0x00000" length="0x18000"/>
        <part repeat="0x0d8000">00</part>

        <!-- 0x0500000: alternate P/N 1049 Rev 1 discrete GROM packing. -->
        <interleave output="32">
            <part name="timekill_grom00.grom00" crc="980aab02" map="0001"/>
            <part name="timekill_grom05.grom05" crc="0b28ae65" map="0010"/>
            <part name="timekill_grom10.grom10" crc="6092c59e" map="0100"/>
            <part name="timekill_grom15.grom15" crc="b08497c1" map="1000"/>
        </interleave>
        <interleave output="32">
            <part name="timekill_grom01.grom01" crc="c37d9486" map="0001"/>
            <part name="timekill_grom06.grom06" crc="f698fc14" map="0010"/>
            <part name="timekill_grom11.grom11" crc="69735cd0" map="0100"/>
            <part name="timekill_grom16.grom16" crc="1fe7cd97" map="1000"/>
        </interleave>
        <interleave output="32">
            <part name="timekill_grom02.grom02" crc="a7b9240c" map="0001"/>
            <part name="timekill_grom07.grom07" crc="fb9c04d2" map="0010"/>
            <part name="timekill_grom12.grom12" crc="383adf84" map="0100"/>
            <part name="timekill_grom17.grom17" crc="77dcbf80" map="1000"/>
        </interleave>
        <interleave output="32">
            <part name="timekill_grom03.grom03" crc="7a464aa0" map="0001"/>
            <part name="timekill_grom08.grom08" crc="7d6f7ba9" map="0010"/>
            <part name="timekill_grom13.grom13" crc="ecde039d" map="0100"/>
            <part name="timekill_grom18.grom18" crc="05cb6d82" map="1000"/>
        </interleave>
        <interleave output="32">
            <part name="timekill_grom04.grom04" crc="b030c3d9" map="0001"/>
            <part name="timekill_grom09.grom09" crc="e98492a4" map="0010"/>
            <part name="timekill_grom14.grom14" crc="6088fa64" map="0100"/>
            <part name="timekill_grom19.grom19" crc="95be2318" map="1000"/>
        </interleave>
        <part repeat="0x1880000">00</part>

        <!-- 0x2600000: ES5506 region 2, three populated even byte lanes. -->
        <interleave output="16">
            <part name="tksrom00_u18.u18" crc="79d8b83a" map="01"/>
            <part repeat="0x080000" map="10">00</part>
        </interleave>
        <interleave output="16">
            <part name="tksrom01_u20.u20" crc="ec01648c" map="01"/>
            <part repeat="0x080000" map="10">00</part>
        </interleave>
        <interleave output="16">
            <part name="tksrom02_u26.u26" crc="051ced3e" map="01"/>
            <part repeat="0x080000" map="10">00</part>
        </interleave>
        <part repeat="0x100000">00</part>

        <!-- Reserve unused ES region 3; writable VRAM begins at 0x2e00000. -->
        <part repeat="0x400000">00</part>
    </rom>
</misterromdescription>
