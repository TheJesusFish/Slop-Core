<misterromdescription>
    <name>FixEight (Taiwan, Taito license)</name>
    <setname>fixeighttwt</setname>
    <rbf>FixEight</rbf>
    <mameversion>0288</mameversion>
    <year>1992</year>
    <manufacturer>Toaplan (Taito license)</manufacturer>
    <players>3</players>
    <joystick>8-way</joystick>
    <rotation>Vertical (CCW)</rotation>
    <platform>Toaplan TP-026</platform>
    <category>Run and gun</category>

    <buttons names="Button 1,Button 2,-,Start,Coin,Pause" default="A,B,-,Start,Select,L" count="3"/>

    <!-- Official TP-026 settings live in the 93C46; there are no DIPs. -->
    <rom index="0" zip="fixeighttwt.zip|fixeight.zip" md5="65717dfea7621340c7fcc5059d582287" address="0x30000000">
        <!-- MAME ROM_LOAD16_WORD_SWAP: adjacent bytes become CPU order. -->
        <interleave output="16">
            <part name="tp-026-1" crc="f7b1746a" map="12"/>
        </interleave>

        <!-- One linear 4 MiB GP9001 graphics region. -->
        <part name="tp-026-3" crc="e5578d98"/>
        <part name="tp-026-4" crc="b760cb53"/>

        <!-- Linear 256 KiB MSM6295 sample region. -->
        <part name="tp-026-2" crc="85063f1f"/>

        <!-- Exact 128-byte per-set 93C46 seed. -->
        <part name="fixeighttwt.nv" crc="b6d5c06c"/>
    </rom>

    <!-- Vertical/CCW donor polarity and normal framework volume. -->
    <rom index="1">
        <part>05 80</part>
    </rom>

    <!-- MAME high-score work RAM: 135 bytes, including the repeated guard. -->
    <rom index="4">
        <part>
            00 10 04 08 00 04 00 00
            00 10 04 3c 00 82 00 04
            00 10 04 0a 00 01 53 53
        </part>
    </rom>
    <nvram index="2" size="272"/>
</misterromdescription>
