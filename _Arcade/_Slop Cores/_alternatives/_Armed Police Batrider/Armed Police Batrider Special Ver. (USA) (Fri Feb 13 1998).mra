<misterromdescription>
    <name>Armed Police Batrider (USA) (Fri Feb 13 1998)</name>
    <setname>batrideru</setname>
    <rbf>Batrider</rbf>
    <mameversion>0245</mameversion>
    <year>1998</year>
    <manufacturer>Raizing / Eighting</manufacturer>
    <players>2</players>
    <joystick>8-way</joystick>
    <rotation>vertical (ccw)</rotation>
    <region>USA</region>
    <platform>Toaplan 2</platform>
    <category>Shoot'em up</category>
    <catver>Shooter / Flying Vertical</catver>
    <rom index="0" address="0x30000000" zip="batrideru.zip|batrider.zip" md5="None">
        <!-- maincpu - starts at 0x0 -->
        <interleave output="16">
            <part name="prg0_usa.u22" crc="2049d007" map="01" length="0x80000" />
            <part name="prg1b.u23" crc="8e70b492" map="10" length="0x80000" />
        </interleave>
        <interleave output="16">
            <part name="prg2.u21" crc="bdaa5fbf" map="01" length="0x80000" />
            <part name="prg3.u24" crc="7aa9f941" map="10" length="0x80000" />
        </interleave>
        <!-- audiocpu - starts at 0x200000 -->
        <part name="snd.u77" crc="56682696" length="0x40000" />
        <!-- gp9001_0 - starts at 0x240000 -->
        <interleave output="16">
            <part name="rom-1.bin" crc="0df69ca2" map="01" length="0x400000" />
            <part name="rom-2.bin" crc="1bfea593" map="10" length="0x400000" />
        </interleave>
        <interleave output="16">
            <part name="rom-3.bin" crc="60167d38" map="01" length="0x400000" />
            <part name="rom-4.bin" crc="bee03c94" map="10" length="0x400000" />
        </interleave>
        <!-- oki1 - starts at 0x1240000 -->
        <part name="rom-5.bin" crc="4274daf6" length="0x100000" />
        <!-- oki2 - starts at 0x1340000 -->
        <part name="rom-6.bin" crc="2a1c2426" length="0x100000" />
        <!-- Total 0x1440000 bytes - 20736 kBytes -->
        <!-- always boot into special ver. -->
        <patch offset="0x25c">
            50
        </patch>
        <!-- always start at minimum rank -->
        <patch offset="0x1aa8">
            00
        </patch>
    </rom>
    <!-- Vertical screen. Orientation reversed. -->
    <!-- default high score table for special ver -->
    <rom index="2">
        <part>
            00 00 FF 00 00 07 A1 20 20 35 30 30 30 30 30 00 2A 2A 2A 00 90 94 98 00 00 00 20 31 00 00 02 00
